# Copiar a .env y completar. .env nunca se commitea.

# Postgres (docker compose)
POSTGRES_USER=ccap
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=ccap
DATABASE_URL=postgresql+psycopg://ccap:cambiar-esto@127.0.0.1:5433/ccap

# Cifrado de tokens (ADR-0005). Formato: version:llave_base64 separados por coma.
# Generar: python -c "import os,base64;print('1:'+base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEYS=

# IA (ADR-0003)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Login (RF-01, ADR-0008)
# URL donde se abre la PWA. Los redirect URI son {APP_URL}/api/auth/{google|microsoft}/callback.
APP_URL=http://localhost:5173
# Firma la cookie temporal del flujo OAuth. Mínimo 32 caracteres.
# Generar: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Correos que pueden iniciar sesión, separados por coma. Vacío: nadie entra.
ALLOWED_EMAILS=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cambiar@example.com
